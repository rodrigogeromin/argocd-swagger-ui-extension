{
  "name": "swagger-gateway",
  "description": "Browse OpenAPI publications through the authenticated Argo CD Swagger Gateway proxy.",
  "argoCdVersion": "3.5.1",
  "profile": "system-level",
  "registration": {
    "title": "Swagger",
    "path": "/swagger",
    "icon": "fa-book"
  },
  "dataSource": "proxy",
  "backend": {
    "kind": "proxy"
  },
  "schemaVersion": 2,
  "templateVersion": "2.2.1",
  "hostContract": {
    "sourceKind": "official",
    "tag": "v3.5.1",
    "sources": [
      "https://github.com/argoproj/argo-cd/blob/v3.5.1/ui/src/app/shared/services/extensions-service.ts",
      "https://github.com/argoproj/argo-cd/blob/v3.5.1/ui/src/app/index.tsx",
      "https://github.com/argoproj/argo-cd/blob/v3.5.1/ui/package.json",
      "https://github.com/argoproj/argo-cd/blob/v3.5.1/ui/pnpm-lock.yaml"
    ],
    "profile": "system-level",
    "method": "registerSystemLevelExtension",
    "signature": "registerSystemLevelExtension(component, title, path, icon)",
    "props": [],
    "globals": [
      "React",
      "ReactDOM",
      "ReactJSXRuntime"
    ],
    "jsxMode": "automatic",
    "argumentMap": [
      "component",
      "registration.title",
      "registration.path",
      "registration.icon"
    ],
    "flyoutProps": [],
    "runtime": {
      "react": "19.2.6",
      "reactDom": "19.2.6",
      "typesReact": "19.2.14",
      "typesReactDom": "19.2.3"
    }
  },
  "origin": {
    "templateSha256": "a025a4141f3f42926d12fb37f1ceb7c2fbeda736e4466ce228c4118059fef803",
    "adaptations": [
      "Swagger catalog and trusted HTML flyout using authenticated proxy, base-href-aware paths, cancellation and context validation.",
      "Host-owned top bar action restricted to argocd:swagger-gateway in appset; domain and production bundle tests replace scaffold assertions.",
      "Node 26.10.0/npm 11.19.1 and webpack-dev-server 6.1.0; patched transitive development dependencies.",
      {
        "kind": "profile-change",
        "from": "top-bar-action",
        "to": "system-level",
        "reason": "Independent Swagger page with explicit authorized PoC proxy context"
      },
      {
        "kind": "manifest-migration",
        "fromSchema": 2,
        "fromTemplate": "2.2.1",
        "validatorTemplate": "2.2.1"
      }
    ]
  },
  "compatibility": {
    "localBuild": "not-run",
    "harness": "not-run",
    "integrated": []
  }
}
